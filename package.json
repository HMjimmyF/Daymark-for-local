{
    "name": "daymark",
    "version": "1.0.0",
    "private": true,
    "description": "日序 Daymark - 完全本地运行的 Windows 待办应用",
    "main": "dist/main/index.js",
    "author": "Daymark",
    "license": "MIT",
    "scripts": {
        "dev": "yarn native:electron && node scripts/dev.js",
        "build": "node scripts/build.js",
        "native:electron": "node scripts/install-native.js",
        "lint": "yarn lint:biome && yarn lint:eslint",
        "lint:biome": "biome check .",
        "lint:eslint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node scripts/run-vitest.js",
        "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
        "check": "yarn format:check && yarn lint && yarn test",
        "check:native": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/smoke-native.js",
        "icons": "node scripts/generate-icons.js",
        "package:win": "yarn native:electron && yarn build && electron-builder --win dir",
        "dist:win": "yarn native:electron && yarn build && electron-builder --win dir && node scripts/zip-release.js"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "1.1.6",
        "@radix-ui/react-dropdown-menu": "2.1.6",
        "@radix-ui/react-label": "2.1.2",
        "@radix-ui/react-select": "2.1.6",
        "@radix-ui/react-slot": "1.1.2",
        "@radix-ui/react-switch": "1.1.3",
        "@radix-ui/react-tooltip": "1.1.8",
        "better-sqlite3": "11.8.1",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "date-fns": "4.1.0",
        "lucide-react": "0.479.0",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "tailwind-merge": "3.0.2",
        "zod": "3.24.2",
        "zustand": "5.0.3"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@rspack/core": "1.3.2",
        "@rspack/dev-server": "1.1.1",
        "archiver": "7.0.1",
        "autoprefixer": "10.4.21",
        "cross-env": "7.0.3",
        "css-loader": "7.1.2",
        "electron": "34.5.8",
        "electron-builder": "26.0.12",
        "eslint": "9.22.0",
        "eslint-plugin-react": "7.37.4",
        "eslint-plugin-react-hooks": "5.2.0",
        "eslint-plugin-react-refresh": "0.4.19",
        "postcss": "8.5.3",
        "postcss-loader": "8.1.1",
        "prettier": "3.5.3",
        "style-loader": "4.0.0",
        "tailwindcss": "3.4.17",
        "vitest": "3.0.8"
    },
    "build": {
        "appId": "com.daymark.desktop",
        "productName": "日序",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "resources/**/*",
            "package.json"
        ],
        "asar": true,
        "asarUnpack": [
            "node_modules/better-sqlite3/**/*",
            "node_modules/bindings/**/*"
        ],
        "npmRebuild": false,
        "win": {
            "icon": "resources/app-icon.ico",
            "target": [
                {
                    "target": "dir",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Daymark-${version}-${arch}.${ext}"
        }
    },
    "engines": {
        "node": ">=20"
    }
}
